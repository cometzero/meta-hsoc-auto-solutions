#!/bin/sh
# SPDX-License-Identifier: MIT
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
failed_init() {
    printf '%s\n' 'NEXIOS_GEM5_INITRAMFS_FAILED'
    export PS1='nexios-gem5-failed# '
    exec sh
}
mkdir -p /proc /sys /dev /run /tmp || failed_init
mount -t proc proc /proc || failed_init
mount -t sysfs sysfs /sys || failed_init
if ! grep -qs ' /dev ' /proc/mounts; then
    mount -t devtmpfs devtmpfs /dev || failed_init
fi
mkdir -p /dev/pts || failed_init
mount -t devpts devpts /dev/pts || failed_init
mount -t tmpfs tmpfs /run || failed_init

printf '%s\n' 'NEXIOS_GEM5_INITRAMFS_READY'
case " $(cat /proc/cmdline) " in
    *' gem5.checkpoint=1 '*)
        /usr/bin/gem5-control checkpoint || failed_init
        ;;
esac
/usr/bin/gem5-control readfile > /run/gem5-workload.sh || failed_init
if test -s /run/gem5-workload.sh || test -f /etc/gem5-workload.sh; then
    /usr/bin/gem5-workload
    printf 'NEXIOS_GEM5_WORKLOAD_EXIT status=%s\n' "$?"
fi
export PS1='nexios-gem5# '
exec setsid -c sh </dev/console >/dev/console 2>&1
