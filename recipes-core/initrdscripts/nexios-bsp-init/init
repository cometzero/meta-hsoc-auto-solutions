#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mkdir -p /proc /sys /dev /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
grep -qs " /dev " /proc/mounts || mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run

mkdir -p /sys/kernel/debug
grep -qw debugfs /proc/filesystems &&
    mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
grep -qw configfs /proc/filesystems &&
    mount -t configfs configfs /sys/kernel/config 2>/dev/null

mdev -s
depmod -a

failed_shell() {
    printf '%s\n' 'NEXIOS_BSP_INITRAMFS_FAILED'
    export PS1='nexios-bsp-failed# '
    exec setsid -c sh </dev/console >/dev/console 2>&1
}

machine="$(cat /etc/nexios-bsp-machine)"
for module in virtio_rpmsg_bus arm_si_rproc rpmsg_net pfdi_misc; do
    set -- "${module}"
    if test "${module}" = "pfdi_misc" && test "${machine}" = "apollo-qvp"; then
        set -- "${module}" pfdi_wait_timeout_ms=1000
    fi
    if modprobe "$@" 2>/dev/null; then
        printf 'NEXIOS_BSP_MODULE name=%s result=PASS\n' "${module}"
    else
        printf 'NEXIOS_BSP_MODULE name=%s result=SKIP\n' "${module}"
    fi
done

pfdi_app=/usr/bin/pfdi-sample-app
pfdi_config=/etc/pfdi/pfdi_test_config_0.pack
if test -x "${pfdi_app}" && test -r "${pfdi_config}"; then
    "${pfdi_app}" -i -c "${pfdi_config}" \
        >/run/pfdi-sample-app.log 2>&1 &
    sleep 1
    if pidof pfdi-sample-app >/dev/null; then
        printf '%s\n' 'NEXIOS_BSP_SERVICE name=pfdi result=PASS'
    else
        printf '%s\n' 'NEXIOS_BSP_SERVICE name=pfdi result=FAIL'
    fi
else
    printf '%s\n' 'NEXIOS_BSP_SERVICE name=pfdi result=FAIL'
fi

if ! /usr/libexec/nexios-bsp/selftest; then
    failed_shell
fi

network_interface=""
for device_path in /sys/class/net/*; do
    device_name="${device_path##*/}"
    case "${device_name}" in
        lo|sit*|ip6tnl*|tunl*) continue ;;
    esac
    network_interface="${device_name}"
    break
done

if test -z "${network_interface}" ||
    ! ip link set "${network_interface}" up ||
    ! udhcpc -n -q -t 10 -T 1 -i "${network_interface}"; then
    printf 'NEXIOS_BSP_NETWORK interface=%s result=FAIL\n' \
        "${network_interface:-missing}"
    failed_shell
fi
printf 'NEXIOS_BSP_NETWORK interface=%s result=PASS\n' "${network_interface}"

mkdir -p /etc/dropbear
dropbear_key=/etc/dropbear/dropbear_rsa_host_key
if ! dropbearkey -t rsa -f "${dropbear_key}" >/run/dropbearkey.log 2>&1 ||
    ! dropbear -r "${dropbear_key}" -p 22 -B ||
    ! pidof dropbear >/dev/null; then
    printf '%s\n' 'NEXIOS_BSP_SSH daemon=dropbear result=FAIL'
    failed_shell
fi
printf '%s\n' 'NEXIOS_BSP_SSH daemon=dropbear result=PASS'

printf 'NEXIOS_BSP_INITRAMFS_READY machine=%s\n' "${machine}"
export PS1='nexios-bsp# '
printf '%s\n' 'nexios-bsp#'
exec setsid -c sh </dev/console >/dev/console 2>&1
