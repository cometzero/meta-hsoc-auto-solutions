+static int positive_number(const char *text, int maximum)
+{
+    int value = 0;
+    const unsigned char *p = (const unsigned char *)text;
+    if (!*p)
+        return 0;
+    for (; *p; p++) {
+        if (*p < '0' || *p > '9' || value > (maximum - (*p - '0')) / 10)
+            return 0;
+        value = value * 10 + (*p - '0');
+        if (value > maximum)
+            return 0;
+    }
+    return value;
+}
+
+static void usage(const char *program)
+{
+    printf("Usage: %s [option value]...\n"
+           "  --bandwidth-size-kib N  even KiB, 2..524288 (default 32768)\n"
+           "  --latency-size-kib N    power of two, 1..524288 (default 65536)\n"
+           "  --duration-ms N         1..2147483647 (default 500)\n"
+           "  --repeats N             1..1000 (default %d)\n"
+           "  --latency-count N       multiple of 16, 16..2147483632 (default %d)\n"
+           "  --help\n", program, MAXREPEATS, LATBENCH_COUNT);
+}
 
