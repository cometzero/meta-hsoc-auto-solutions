Subject: [PATCH] cmake: honor symbol packaging option for utilities

Leave debug splitting and stripping to the distribution when symbol
packaging is disabled. Utility targets call this macro unconditionally.

Upstream-Status: Pending

--- a/SilKit/cmake/SilKitBuildTools.cmake
+++ b/SilKit/cmake/SilKitBuildTools.cmake
@@ -5,7 +5,7 @@
 include(CMakeFindBinUtils)
 
 macro(silkit_split_debugsymbols targetName)
-    if(NOT MSVC 
+    if(SILKIT_PACKAGE_SYMBOLS AND NOT MSVC
        AND (CMAKE_STRIP AND EXISTS ${CMAKE_STRIP})
        AND (CMAKE_OBJCOPY AND EXISTS ${CMAKE_OBJCOPY})
       )
